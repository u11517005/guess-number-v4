const KEY="MY_V4_SHEET_ID";
function doGet(){return HtmlService.createHtmlOutputFromFile("Index").setTitle("猜數字遊戲版本四");}
function email_(){const e=Session.getActiveUser().getEmail();if(!e)throw Error("無法取得登入者 Google 帳號。請確認部署執行身分為「使用網頁應用程式的使用者」，並使用 Google 帳號登入。");return e;}
function ss_(){const p=PropertiesService.getUserProperties(),id=p.getProperty(KEY);if(id){try{return SpreadsheetApp.openById(id)}catch(e){}}email_();const s=SpreadsheetApp.create("猜數字遊戲版本四資料");s.getSheets()[0].setName("Games").appendRow(["gameId","answer","status","createdAt","updatedAt"]);s.insertSheet("Guesses").appendRow(["gameId","guess","a","b","time"]);p.setProperty(KEY,s.getId());return s;}
function gameData_(){const s=ss_(),g=s.getSheetByName("Games").getDataRange().getValues(),q=s.getSheetByName("Guesses").getDataRange().getValues(),out=[];for(let i=1;i<g.length;i++){let r=g[i],gs=[];for(let j=1;j<q.length;j++)if(String(q[j][0])===String(r[0]))gs.push({guess:String(q[j][1]),a:+q[j][2],b:+q[j][3],time:String(q[j][4])});out.push({gameId:String(r[0]),answer:String(r[1]),status:String(r[2]),createdAt:String(r[3]),updatedAt:String(r[4]),guesses:gs});}out.sort((a,b)=>new Date(a.createdAt)-new Date(b.createdAt));return {ss:s,games:out};}
function getUserData(){const d=gameData_();let c=null;for(let i=d.games.length-1;i>=0;i--)if(d.games[i].status==="unfinished"){c=d.games[i];break;}if(!c&&d.games.length)c=d.games[d.games.length-1];return {email:email_(),sheetUrl:d.ss.getUrl(),games:d.games.map(pub_),currentGame:c?pub_(c):null};}
function pub_(g){return {gameId:g.gameId,status:g.status,createdAt:g.createdAt,updatedAt:g.updatedAt,guesses:g.guesses};}
function startNewGame(){const s=ss_(),digits="0123456789".split("");for(let i=9;i>0;i--){let j=Math.floor(Math.random()*(i+1));[digits[i],digits[j]]=[digits[j],digits[i]];}let now=new Date().toISOString(),id=Utilities.getUuid();s.getSheetByName("Games").appendRow([id,digits.slice(0,4).join(""),"unfinished",now,now]);return {ok:true};}
function submitGuess(id,v){v=String(v||"");if(!/^\d{4}$/.test(v)||new Set(v).size!==4)throw Error("請輸入四位且不重複的數字。");let d=gameData_(),s=d.ss,sh=s.getSheetByName("Games"),r=0;for(let i=1;i<sh.getLastRow();i++)if(String(sh.getRange(i+1,1).getValue())===id){r=i+1;break;}if(!r)throw Error("找不到這局遊戲。");let row=sh.getRange(r,1,1,5).getValues()[0];if(row[2]==="completed")throw Error("本局已完成。");let ans=String(row[1]),a=[...v].filter((x,i)=>x===ans[i]).length,b=[...v].filter(x=>ans.includes(x)).length-a,now=new Date().toISOString();s.getSheetByName("Guesses").appendRow([id,v,a,b,now]);if(a===4)sh.getRange(r,3).setValue("completed");sh.getRange(r,5).setValue(now);return {a:a,b:b};}
function getDebugAnswer(id){let d=gameData_(),g=d.games.find(x=>x.gameId===id);if(!g)throw Error("找不到遊戲。");return {answer:g.answer};}
